@page "/"
@inject IProcurementConciergeApiClient ConciergeService
@rendermode InteractiveServer

<PageTitle>Procurement Adoption Concierge</PageTitle>

<div class="row">
    <div class="col-lg-6">
        <h2 class="h5">Describe your procurement need</h2>
        <p class="text-muted">
            Enter your request in natural language. Example: "I'm located in France. I need a
            marketing agency for a campaign. Budget is €80,000. We normally use Agency X."
        </p>

        <textarea class="form-control mb-3" rows="6" @bind="_message" placeholder="Describe your procurement request..."></textarea>

        <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_isProcessing">
            @if (_isProcessing)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            Get 

        </button>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3">@_errorMessage</div>
        }

        <hr class="my-4" />

        <h2 class="h5">Example prompts</h2>
        <p class="text-muted">Click an example to load it and see a different outcome.</p>

        <div class="list-group">
            @foreach (var example in _examplePrompts)
            {
                <button type="button" class="list-group-item list-group-item-action" @onclick="() => LoadExample(example.Message)">
                    <div class="d-flex w-100 justify-content-between">
                        <strong>@example.Title</strong>
                        <span class="badge @ExampleBadgeClass(example.ExpectedOutcome)">@example.ExpectedOutcome</span>
                    </div>
                    <p class="mb-1 text-muted small">@example.Message</p>
                </button>
            }
        </div>
    </div>

    <div class="col-lg-6">
        @if (_response is not null)
        {
            <GuidanceResultHeader Response="_response" />

            <ul class="nav nav-tabs">
                @foreach (var tab in _tabs)
                {
                    <li class="nav-item">
                        <button type="button" class="nav-link @(_activeTab == tab ? "active" : "")" @onclick="() => SetActiveTab(tab)">@tab</button>
                    </li>
                }
            </ul>

            <div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
                @if (_activeTab == "Overview")
                {
                    <OverviewTab Response="_response" />
                }
                else if (_activeTab == "Compliance & Policy")
                {
                    <CompliancePolicyTab Response="_response" />
                }
                else if (_activeTab == "Suppliers & Country")
                {
                    <SuppliersCountryTab Response="_response" />
                }
                else if (_activeTab == "Coupa Output")
                {
                    <CoupaOutputTab Response="_response" />
                }
                else if (_activeTab == "Coaching & Quality")
                {
                    <CoachingQualityTab Response="_response" />
                }
                else if (_activeTab == "Agent Trace")
                {
                    <AgentTraceTab Response="_response" />
                }
            </div>
        }
        else
        {
            <p class="text-muted">Submit a procurement request to see guidance here.</p>
        }
    </div>
</div>

@code {
    private string _message = string.Empty;
    private ProcurementResponse? _response;
    private bool _isProcessing;
    private string? _errorMessage;

    private readonly string[] _tabs = { "Overview", "Compliance & Policy", "Suppliers & Country", "Coupa Output", "Coaching & Quality", "Agent Trace" };
    private string _activeTab = "Overview";

    private void SetActiveTab(string tab) => _activeTab = tab;

    private sealed record ExamplePrompt(string Title, string Message, string ExpectedOutcome);

    private readonly List<ExamplePrompt> _examplePrompts = new()
    {
        new ExamplePrompt(
            "Compliant, preferred supplier",
            "I'm located in France. I need a marketing agency for a campaign. Budget is €40,000. We normally use Havas because our brand guidelines require a consistent agency.",
            "High"),
        new ExamplePrompt(
            "Non-preferred supplier deviation",
            "I'm located in Germany. I need an IT services provider for a new project. Budget is €90,000. We want to use a boutique local agency instead of our usual suppliers.",
            "Medium"),
        new ExamplePrompt(
            "Large spend requiring CPO approval",
            "I'm located in the United States. I need professional services for a legal review. Budget is $220,000. We normally use Deloitte since this is a critical compliance matter.",
            "High"),
        new ExamplePrompt(
            "Unknown category",
            "I'm located in Spain. I need to procure some office plants and decorations for our new building. Budget is €15,000.",
            "Low"),
        new ExamplePrompt(
            "Missing spend amount",
            "I'm located in Italy. I need a marketing agency for an upcoming product launch because our current campaign is underperforming.",
            "Medium"),
        new ExamplePrompt(
            "Missing country",
            "I need an IT services provider to help modernize our internal systems. Budget is €120,000 because our current platform is out of support.",
            "Medium"),
        new ExamplePrompt(
            "Low confidence / needs human review",
            "Need some help with a thing, maybe around 5k, not sure where yet.",
            "Low"),
        new ExamplePrompt(
            "Missing business justification",
            "I'm located in Belgium. I need a professional services firm. Budget is €70,000. We usually use PwC.",
            "Medium"),
        new ExamplePrompt(
            "Low quality request needing coaching",
            "We need to buy something soon.",
            "Low"),
    };

    private void LoadExample(string message)
    {
        _message = message;
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_message))
        {
            _errorMessage = "Please describe your procurement request first.";
            return;
        }

        _errorMessage = null;
        _isProcessing = true;
        _response = null;
        _activeTab = "Overview";

        try
        {
            var request = new ProcurementRequest { Message = _message };
            _response = await ConciergeService.ProcessRequestAsync(request);
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while processing your request: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private static string ExampleBadgeClass(string expectedComplianceLevel) => expectedComplianceLevel switch
    {
        "High" => "bg-success",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-danger",
        _ => "bg-secondary"
    };
}

